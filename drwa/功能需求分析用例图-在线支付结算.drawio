<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" modified="2026-06-06T00:00:00.000Z" agent="Claude" version="21.0.0">
  <diagram id="payment" name="在线支付结算模块">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- 系统边界 -->
        <mxCell id="boundary" value="在线支付结算模块" style="shape=uml.frame;whiteSpace=wrap;html=1;width=650;height=520;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=16;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="380" y="90" width="650" height="520" as="geometry"/>
        </mxCell>

        <!-- 参与者：用户 -->
        <mxCell id="actor_user" value="" style="shape=uml.actor;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;size=40;" vertex="1" parent="1">
          <mxGeometry x="200" y="220" width="60" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="actor_user_label" value="用户" style="text;html=1;align=center;verticalAlign=top;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="190" y="305" width="80" height="30" as="geometry"/>
        </mxCell>

        <!-- 参与者：管理员 -->
        <mxCell id="actor_admin" value="" style="shape=uml.actor;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;outlineConnect=0;fillColor=#fff2cc;strokeColor=#d6b656;size=40;" vertex="1" parent="1">
          <mxGeometry x="1140" y="220" width="60" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="actor_admin_label" value="管理员" style="text;html=1;align=center;verticalAlign=top;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1125" y="305" width="90" height="30" as="geometry"/>
        </mxCell>

        <!-- 参与者：支付宝系统 -->
        <mxCell id="actor_alipay" value="" style="shape=uml.actor;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;outlineConnect=0;fillColor=#e1d5e7;strokeColor=#9673a6;size=40;" vertex="1" parent="1">
          <mxGeometry x="700" y="530" width="60" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="actor_alipay_label" value="支付宝(系统)" style="text;html=1;align=center;verticalAlign=top;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="675" y="615" width="110" height="30" as="geometry"/>
        </mxCell>

        <!-- 用例：发起支付 -->
        <mxCell id="uc1" value="发起支付" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="440" y="130" width="150" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="l1" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="actor_user" target="uc1" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- 用例：扫码完成支付 -->
        <mxCell id="uc2" value="扫码完成支付" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="440" y="230" width="150" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="l2" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="actor_user" target="uc2" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- 用例：查看支付状态 -->
        <mxCell id="uc3" value="查看支付状态" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="440" y="330" width="150" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="l3" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="actor_user" target="uc3" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- 用例：发起退款 -->
        <mxCell id="uc4" value="发起退款" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="820" y="200" width="150" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="l4" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="actor_admin" target="uc4" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- 用例：确认退款完成 -->
        <mxCell id="uc5" value="确认退款完成" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="820" y="320" width="150" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="l5" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="actor_admin" target="uc5" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- 用例：异步回调通知 -->
        <mxCell id="uc6" value="异步回调通知" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="630" y="420" width="150" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="l6" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="actor_alipay" target="uc6" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- <<include>> 扫码支付 包含 发起支付 -->
        <mxCell id="include1" value="&lt;&lt;include&gt;&gt;" style="dashed=1;endArrow=open;endSize=12;html=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" source="uc2" target="uc1" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- <<extend>> 退款 扩展 支付 -->
        <mxCell id="extend1" value="&lt;&lt;extend&gt;&gt;" style="dashed=1;endArrow=open;endSize=12;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="uc4" target="uc1" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
